{
  "name": "candledrill-monorepo",
  "private": true,
  "version": "0.2.7",
  "description": "CandleDrill (K\u7dda\u64cd\u7df4\u5834): free, self-hosted candlestick replay practice tool. Educational only.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w @candledrill/server",
    "dev:web": "npm run dev -w @candledrill/web",
    "build": "npm run build -w @candledrill/web",
    "start": "npm run build && npm run start -w @candledrill/server",
    "serve": "npm run start -w @candledrill/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "screenshot": "node scripts/screenshot.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:secrets": "bash scripts/secret-scan.sh",
    "check:no-market-data": "node scripts/check-no-market-data.mjs",
    "oracle": "node --import tsx tools/oracle/dump.ts .oracle-cases.json 1000 1 && node scripts/run-python.mjs tools/oracle/check.py .oracle-cases.json",
    "bench": "node --import tsx scripts/bench.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:licenses && npm run check:no-market-data && npm run check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
