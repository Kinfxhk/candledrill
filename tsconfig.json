{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "tools/**/*.ts",
    "scripts/**/*.ts"
  ]
}
